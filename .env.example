# Required ----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lightwall
SESSION_SECRET=change-this-to-a-long-random-string-at-least-16-chars

# Server ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Auth --------------------------------------------------------------
DEFAULT_ADMIN_PASSWORD=change-this-password

# AI integrations (recommended in production) -----------------------
# Quando estas vars sao definidas, elas tem prioridade sobre qualquer
# chave configurada via Settings na UI — e a UI fica read-only.
AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-api-key-here
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_MODEL=gpt-5-mini

# CV Service (Python FastAPI) — optional, auto-fallback to Gemini-only if unavailable
CV_SERVICE_URL=http://localhost:8100
